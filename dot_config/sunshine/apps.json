{
    "env": {
        "PATH": "$(PATH):$(HOME)/.local/bin"
    },
    "apps": [
        {
            "name": "Desktop",
            "image-path": "desktop.png"
        },
        {
            "name": "Steam Big Picture",
            "detached": [
                "setsid flatpak run com.valvesoftware.Steam steam://open/bigpicture"
            ],
            "prep-cmd": [
                {
                    "do": "",
                    "undo": "setsid flatpak run com.valvesoftware.Steam steam://close/bigpicture"
                }
            ],
            "image-path": "steam.png"
        },
        {
            "name": "Steam (Couch)",
            "detached": [
                "setsid flatpak run com.valvesoftware.Steam steam://open/bigpicture"
            ],
            "prep-cmd": [
                {
                    "do": "",
                    "undo": "hyprctl eval 'hl.dispatch(hl.dsp.window.move({ window = \"class:^(steam|steam_app_[0-9]+)$\", workspace = \"name:gaming\", follow = false }))'"
                },
                {
                    "do": "",
                    "undo": "setsid flatpak run com.valvesoftware.Steam steam://close/bigpicture"
                },
                {
                    "do": "couch-route start",
                    "undo": "couch-route stop"
                }
            ],
            "image-path": "steam.png"
        },
        {
            "name": "Emulation",
            "detached": [
                "setsid -f es-session start"
            ],
            "prep-cmd": [
                {
                    "do": "couch-route start",
                    "undo": "couch-route stop"
                }
            ]
        },
        {
            "name": "Emulation (Stop)",
            "detached": [
                "setsid -f es-session stop"
            ]
        }
    ]
}
